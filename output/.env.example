# Copiá este archivo como .env. El .env no se sube al repo.
#
# Sin clave, la app usa tu sesión del CLI `claude` (modo local, para probar).
# Con clave, usa la API de Claude (console.anthropic.com): es lo que necesita la app publicada.
ANTHROPIC_API_KEY=

# Opcionales
# TUTOR_PROVIDER=sesion    # api | sesion: fuerza un camino aunque haya clave
# CLAUDE_MODEL=claude-opus-5-5   # por la sesión, vacío usa el modelo del CLI
# CLAUDE_EFFORT=low        # low | medium | high: más alto es más preciso pero más lento y caro
# CLAUDE_CLI=claude        # ruta al CLI si no está en el PATH
# PORT=4321
